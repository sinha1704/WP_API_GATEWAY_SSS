# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Master API Key (Full administrative and gateway access)
MASTER_API_KEY=master_secret_key_whatsapp_gateway_2026

# Scoped API Keys (JSON map of apiKey to allowed JIDs or empty array for unrestricted)
# Format: {"agent_sales_key": ["1234567890@s.whatsapp.net", "9876543210@s.whatsapp.net"], "read_only_key": []}
SCOPED_API_KEYS={}

# Webhook Configuration
GLOBAL_WEBHOOK_URL=http://localhost:4000/webhook
WEBHOOK_SECRET=gateway_webhook_signature_secret_xyz

# Anti-Ban / Throttling Guardrails
# Minimum and maximum simulated typing indicator delay in milliseconds
PRESENCE_MIN_DELAY_MS=1500
PRESENCE_MAX_DELAY_MS=3000

# Minimum spacing between outbound messages per session in milliseconds (default 3000ms = 3s)
QUEUE_MESSAGE_DELAY_MS=3000

# AI Bridge Configuration (OpenAI, Anthropic, or Gemini compatible REST endpoint)
AI_BRIDGE_ENABLED=false
AI_PROVIDER=openai
# Supports openai, gemini, or custom
AI_API_KEY=your_api_key_here
AI_MODEL=gpt-4o-mini
AI_SYSTEM_PROMPT="You are a helpful and polite WhatsApp customer support assistant. Keep answers concise, clear, and formatted nicely for WhatsApp."

# Voice-to-Database / ERP Query Pipeline
VOICE_QUERY_ENABLED=true
# Voice transcription provider: groq (free tier 0.5s), openai, gemini, or local_whisper
VOICE_TRANSCRIPTION_PROVIDER=groq
# Groq API Key (Option B: Free Cloud Tier - 14,400 requests/day, lightning fast 0.5s latency)
GROQ_API_KEY=your_groq_api_key_here
# Option A: Self-hosted local Whisper VPS server container (100% Free, Private)
LOCAL_WHISPER_URL=http://localhost:8000/v1/audio/transcriptions

# ERP Database Configuration
ERP_QUERY_ENABLED=true
# Database type: mock (instant zero-setup testing) or postgres (production ERP)
ERP_DB_TYPE=mock
ERP_DB_HOST=localhost
ERP_DB_PORT=5432
# Security Guardrail 1: Strictly Read-Only Database User (GRANT SELECT ON ALL TABLES)
ERP_DB_USER=ai_reader
ERP_DB_PASSWORD=ai_reader_secure_pass
ERP_DB_NAME=erp_database
ERP_DB_SSL=false

# ERP Text-to-SQL LLM Provider (groq for Llama-3.3-70B free tier, gemini, or openai)
ERP_LLM_PROVIDER=groq
ERP_LLM_MODEL=llama-3.3-70b-versatile
